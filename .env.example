# Media extraction runtime (REQUIRED - not optional)
# The resolver shells out to `python -m yt_dlp`; without these the app silently
# returns placeholder metadata for every request.
# Requires: pip install -U yt-dlp  AND  ffmpeg on PATH (for merge/re-encode)
PYTHON_BIN=python
YT_DLP_TIMEOUT_MS=60000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/socialvault

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Storage Configuration (S3-compatible)
STORAGE_BUCKET=socialvault-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# Application Configuration
# Leave empty for same-origin deployments. For Vercel + Render, use the
# Render service URL, for example https://your-api.onrender.com
NEXT_PUBLIC_API_URL=
# Comma-separated browser origins allowed to call the Render API.
# Example: https://social-video-downloaders.vercel.app,http://localhost:3000
API_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW=60
MAX_FILE_SIZE=524288000

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100

# Spline
SPLINE_SCRIPT_URL=https://unpkg.com/@spline-viewer/client@1.2.4

# Rive
RIVE_VERSION=2.0.0

# Lottie
LOTTIE_VERSION=5.12.4